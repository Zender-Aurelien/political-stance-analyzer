# The local demo needs no keys. Copy to backend/.env for optional IBM services.
# Never commit backend/.env or API keys.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Optional public-reference cache. Default: local SQLite in backend/.cache/.
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_DB_NAME=civic-lens
# CACHE_PATH=/absolute/path/to/public-data.sqlite3

# Optional IBM explanations. Scoring works without these.
# Enabling sends policy topic averages and public candidate positions to IBM.
# Demographic context, names of users, and ZIP are not sent to IBM.
ENABLE_WATSONX=false
# Independent opt-in: public profile facts only, no quiz answers or ZIP sent.
ENABLE_WATSONX_BIOS=false
WATSONX_API_KEY=
# Space GUID: cloud.ibm.com → your deployment space → Manage tab → Space GUID
WATSONX_SPACE_ID=
# Region URL: Dallas → https://us-south.ml.cloud.ibm.com
#             Frankfurt → https://eu-de.ml.cloud.ibm.com
#             Tokyo → https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Set to whichever model is deployed in your space. Run:
#   python -m backend.scripts.list_models
# to see available model IDs. Pick one with 'generation' in its tasks list.
# Common choices: ibm/granite-3-1-8b-base  ibm/granite-4-h-small  meta-llama/llama-3-3-70b-instruct
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Open States API v3 — live NY state legislator lookup by ZIP code.
# Register for a free key at https://openstates.org/api/register/
# When absent, all candidate data comes from the bundled data/candidates.json.
OPEN_STATES_API_KEY=
