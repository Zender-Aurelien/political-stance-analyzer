# ============================================================
# Civic Lens Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Google Civic Information API
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable the "Google Civic Information API" for the project.
# ------------------------------------------------------------
GOOGLE_CIVIC_API_KEY=

# ------------------------------------------------------------
# IBM watsonx.ai
# API key:    https://cloud.ibm.com/iam/apikeys
# Project ID: Manage tab → General → Details in your watsonx project
# URL:        Region-specific endpoint, e.g.:
#               us-south → https://us-south.ml.cloud.ibm.com
#               eu-de    → https://eu-de.ml.cloud.ibm.com
#               eu-gb    → https://eu-gb.ml.cloud.ibm.com
#               jp-tok   → https://jp-tok.ml.cloud.ibm.com
# Model ID:   Default is ibm/granite-13b-instruct-v2 — override if needed.
# ------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ------------------------------------------------------------
# IBM Cloudant
# URL:     Manage tab → External Endpoint (preferred) on your Cloudant instance
#          https://cloud.ibm.com/resources → Databases → your instance
# API key: Service credentials tab on the same instance page
# DB name: Choose a name (e.g. civic-lens). Created automatically on first run.
# ------------------------------------------------------------
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_DB_NAME=civic-lens

# ------------------------------------------------------------
# CORS — Frontend origin allowed to call this API
# Local dev:  http://localhost:5500  (or whatever port you use)
# Production: your deployed frontend URL
# Use * to allow all origins (not recommended for production).
# ------------------------------------------------------------
FRONTEND_ORIGIN=*
